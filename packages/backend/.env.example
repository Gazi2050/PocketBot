# Convex backend, local dev. Secrets go on the deployment, not in files:
#   pnpm exec convex env set NAME value [--prod]

CONVEX_DEPLOYMENT=dev:your-deployment
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Required: CLERK_JWT_ISSUER_DOMAIN, HYPER_API_KEY, SITE_URL
# Optional: EXA_API_KEY, SUPERMEMORY_API_KEY, AUTUMN_SECRET_KEY,
# POSTHOG_*, BRAINTRUST_*, AXIOM_*, CLERK_WEBHOOK_SECRET, RESEND_*,
# VERCEL_WEBHOOK_SECRET, MEDIAN_KEY, MEDIAN_SUPPORT_SECRET, KIRKIFY_SECRET
