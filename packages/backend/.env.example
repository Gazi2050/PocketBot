# Convex backend (packages/backend). Copy to .env.local for local dev.
#
# Two kinds of config, two places:
#   1. THIS FILE — only read by the `convex dev` CLI on your machine. Picks
#      which deployment the CLI talks to. Never read in production.
#   2. The deployment itself — every server secret, set with
#      `pnpm exec convex env set NAME value` (add --prod for production) or in
#      the Convex dashboard. Secrets never live in files. See
#      docs/configuration.md for the full reference.

CONVEX_DEPLOYMENT=dev:your-deployment # written automatically on first run
# The deployment's URLs, also written automatically:
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# ---- Deployment env vars (set on the deployment, not here) ------------------

# Required:
#   CLERK_JWT_ISSUER_DOMAIN  Your Clerk Frontend API URL (or the __clerk proxy
#                            URL when Clerk runs behind a domain proxy). Must
#                            match the `iss` claim on minted JWTs exactly.
#   HYPER_API_KEY            Every chat call goes through Hyper.
#   SITE_URL                 The web app's public origin. Defaults to
#                            http://localhost:3000.
#
# Optional (each switches a feature on):
#   EXA_API_KEY, SUPERMEMORY_API_KEY, AUTUMN_SECRET_KEY,
#   POSTHOG_PROJECT_TOKEN, POSTHOG_HOST, POSTHOG_LLM_PRIVACY_MODE,
#   POSTHOG_PERSONAL_API_KEY, POSTHOG_FREE_COST_ENDPOINT,
#   BRAINTRUST_API_KEY, BRAINTRUST_PROJECT_ID, BRAINTRUST_PROJECT_NAME,
#   AXIOM_TOKEN, AXIOM_DATASET, AXIOM_HOST,
#   CLERK_WEBHOOK_SECRET, RESEND_API_KEY, RESEND_AUDIENCE_ID, RESEND_FROM_EMAIL,
#   VERCEL_WEBHOOK_SECRET, MEDIAN_KEY, MEDIAN_SUPPORT_SECRET, KIRKIFY_SECRET
