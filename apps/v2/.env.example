# Web app (apps/v2). Copy to .env.local and fill in for local dev.
# Production values live in Vercel's project environment settings.

# --- Required ----------------------------------------------------------------

# Convex deployment URLs (written by `convex dev` into packages/backend/.env.local).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk. Local dev uses the TEST instance; production needs the LIVE keys
# (pk_live_/sk_live_) set in Vercel, not in this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Optional ----------------------------------------------------------------

# Public origin for canonical URLs and share cards. Filled in automatically
# on Vercel (VEREL_PROJECT_PRODUCTION_URL); set it explicitly elsewhere.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# Clerk domain proxy — production only, when Clerk serves through
# <your-domain>/__clerk (required on vercel.app domains).
# NEXT_PUBLIC_CLERK_PROXY_URL=https://your-domain/__clerk

# PostHog analytics.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Axiom operational telemetry.
# AXIOM_TOKEN=...
# AXIOM_DATASET=web

# Median support agent and Kirkify easter egg (must match the backend).
# MEDIAN_KEY=median_key_...
# MEDIAN_SUPPORT_SECRET=...
# KIRKIFY_SECRET=...

# Build version override; Vercel provides its own.
# GIT_COMMIT_SHA=...

# Extra hosts allowed to reach the dev server, comma-separated.
# DEV_ALLOWED_ORIGINS=http://192.168.1.10:3000
