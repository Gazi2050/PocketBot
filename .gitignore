.DS_Store
.env
node_modules/

# pnpm is the package manager here — its lockfile is committed. Keep the
# other package managers' lockfiles out (a committed package-lock.json makes
# Vercel pick npm, which chokes on workspace:*)
package-lock.json
yarn.lock

# React Router
.react-router/
build/

# clerk configuration (can include secrets)
.clerk/

.env.local

# Vite / Nitro (React Router production build)
apps/*/dist/
apps/*/.output/
.output/
.vite/

# TanStack Start scratch files
.tanstack/

# TypeScript incremental build
*.tsbuildinfo

# Remotion render output

# Per-machine agent state
.agents/settings.local.json
.superpowers/
